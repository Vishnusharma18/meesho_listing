{
  "manifest_version": 3,
  "name": "Vishnu Smart Autofill",
  "version": "2.4",
  "description": "Unlimited smart autofill with auto-increment SKU for faster Meesho catalog uploads. Built by Vishnu.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://supplier.meesho.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://supplier.meesho.com/*"
      ],
      "js": [
        "selector-utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}